<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/loginRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/loginContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="22dp"
            android:paddingTop="40dp"
            android:paddingEnd="22dp"
            android:paddingBottom="24dp">

            <ImageView
                android:layout_width="78dp"
                android:layout_height="78dp"
                android:contentDescription="@string/login_brand_desc"
                android:src="@drawable/logo_scp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:letterSpacing="0.02"
                android:text="@string/app_name"
                android:textColor="@color/text_primary"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/app_subtitle"
                android:textColor="@color/text_hint"
                android:textSize="13sp" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Scp.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                app:cardCornerRadius="24dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="20dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="20dp"
                    android:paddingBottom="18dp">

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/layoutStudent"
                        style="@style/Widget.Scp.TextField"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:hint="@string/login_student_hint">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/inputStudent"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="text"
                            android:maxLines="1"
                            android:textSize="16sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/layoutPassword"
                        style="@style/Widget.Scp.TextField"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:hint="@string/login_password_hint"
                        app:endIconMode="password_toggle">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/inputPassword"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textPassword"
                            android:maxLines="1"
                            android:textSize="16sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <LinearLayout
                        android:id="@+id/captchaRow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:visibility="gone">

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/layoutCaptcha"
                            style="@style/Widget.Scp.TextField"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:hint="@string/login_captcha_hint">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/inputCaptcha"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:imeOptions="actionDone"
                                android:inputType="textVisiblePassword"
                                android:maxLength="8"
                                android:maxLines="1"
                                android:textSize="16sp" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <FrameLayout
                            android:id="@+id/captchaImageBox"
                            android:layout_width="116dp"
                            android:layout_height="58dp"
                            android:layout_marginStart="10dp"
                            android:background="@drawable/bg_captcha"
                            android:clickable="true"
                            android:contentDescription="@string/login_captcha_refresh"
                            android:focusable="true"
                            android:foreground="?attr/selectableItemBackground">

                            <ImageView
                                android:id="@+id/imgCaptcha"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:contentDescription="@string/login_captcha_refresh"
                                android:padding="6dp"
                                android:scaleType="fitCenter" />

                            <TextView
                                android:id="@+id/tvCaptchaLoad"
                                style="@style/TextAppearance.Scp.Body"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:text="@string/login_captcha_loading"
                                android:textSize="10sp" />
                        </FrameLayout>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvCaptchaTip"
                        style="@style/TextAppearance.Scp.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/login_captcha_tip"
                        android:textSize="11sp"
                        android:visibility="gone" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <CheckBox
                            android:id="@+id/checkRememberPassword"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:buttonTint="@color/checkbox_tint"
                            android:checked="false"
                            android:minHeight="40dp"
                            android:text="@string/login_remember_password"
                            android:textColor="@color/text_secondary"
                            android:textSize="13sp" />

                        <CheckBox
                            android:id="@+id/checkAutoLogin"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="18dp"
                            android:buttonTint="@color/checkbox_tint"
                            android:checked="false"
                            android:minHeight="40dp"
                            android:text="@string/login_auto_login"
                            android:textColor="@color/text_secondary"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnLogin"
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:layout_marginTop="10dp"
                        android:fontFamily="@font/noto_sans_sc_bold"
                        android:letterSpacing="0.08"
                        android:text="@string/login_button"
                        android:textSize="15sp"
                        app:backgroundTint="@color/brand_blue"
                        app:cornerRadius="16dp" />

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/progress"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:indeterminate="true"
                        android:visibility="gone"
                        app:indicatorColor="@color/brand_gold"
                        app:trackColor="@color/brand_blue_soft"
                        app:trackCornerRadius="2dp" />

                    <TextView
                        android:id="@+id/tvStatus"
                        style="@style/TextAppearance.Scp.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/login_status_default"
                        android:textSize="12sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSelfCheck"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="8dp"
                android:minHeight="48dp"
                android:text="@string/login_self_check"
                android:textColor="@color/brand_blue"
                app:icon="@drawable/ic_shield"
                app:iconSize="18dp"
                app:iconTint="@color/brand_blue" />

            <TextView
                android:id="@+id/tvVersion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="16dp"
                android:textColor="@color/text_hint"
                android:textSize="11sp" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
